# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# other package managers (this repo uses pnpm)
package-lock.json
yarn.lock

# testing
/coverage

# next.js
/.next/
/out/

# production
/build
/dist

# misc
.DS_Store
Thumbs.db
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log

# env files (keep .env.example tracked if you add one)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# tooling
.eslintcache
.turbo

# tailwind / postcss (caches em disco; o config .ts/.js continua versionado)
.cache/

# IDE / editor
.idea/
*.swp
*.swo
*~

# notas locais de trabalho (não versionadas)
/CLAUDE.md
.claude/

# ---------------------------------------------------------------------------
# Repositório PÚBLICO: nada aqui embaixo pode ser versionado.
# ---------------------------------------------------------------------------

# Material de entrega / documentos comerciais do cliente. O guia do site cita a
# conta Google que entra no painel, o e-mail que recebe os leads, a planilha de
# contatos e canais de suporte — mapa de acesso ao /admin, não vai pro público.
/WVIANA_apresentacao_guia_site.html
/docs/APRESENTACAO_DO_SITE.md
/docs/*.pdf

# Dados coletados de cliente/visitante em runtime (respostas de revisão, leads).
/data/
